@model Article
@{ViewData["Title"]="Перевірка матеріалу";}
<div class="workspace-heading"><a class="back-link" href="/editor">← Редакційна черга</a><div class="article-meta mt-4"><span>@Model.Author.DisplayName</span><span>@Model.Category.Name</span><span class="status-badge status-@Model.Status">@Model.StatusLabel</span></div><h1>@Model.Title</h1><p class="article-lead">@Model.Summary</p></div>
<div class="row g-4"><div class="col-lg-8"><div class="form-paper"><img class="reading-cover mb-4" src="/images/@(Model.CoverKey).svg" alt="@Model.ImageAlt"/><p class="small">Альтернативний текст: @Model.ImageAlt</p><div class="article-body">@foreach(var line in Model.Body.Replace("\r","").Split('\n').Where(s=>s.Trim().Length>0)){<p>@line</p>}</div><div class="source-note"><strong>Джерело фактів</strong><p><a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">Перевірити першоджерело ↗</a></p></div></div></div><aside class="col-lg-4"><div class="form-paper review-panel"><h2>Рішення редактора</h2><p>Перевіряється текстова версія @Model.RevisionNumber.</p><a class="btn btn-outline-dark w-100 mb-4" href="/history/@Model.Id">Порівняти версії</a>@if(Model.Status==ArticleStatus.UnderReview){<form method="post" action="/editor/@Model.Id/publish" class="mb-4">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@Model.Version"/><button class="btn btn-dark w-100" type="submit">Опублікувати</button></form><hr/><form method="post" action="/editor/@Model.Id/return">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@Model.Version"/><label for="comment" class="form-label">Зауваження для автора</label><textarea id="comment" name="comment" class="form-control mb-3" rows="5" minlength="5" maxlength="1000" required placeholder="Що саме потрібно уточнити?"></textarea><button class="btn btn-outline-dark w-100" type="submit">Повернути на доопрацювання</button></form>}else{<p>Рішення щодо цієї версії вже прийняте.</p>@if(Model.Status==ArticleStatus.Published){<a class="btn btn-dark w-100" href="/articles/@Model.Id">Переглянути публікацію ↗</a>}}</div><div class="form-paper mt-4"><h2>Журнал рішень</h2>@foreach(var d in Model.Decisions.OrderByDescending(x=>x.CreatedAtUtc)){<div class="decision-item"><strong>@(d.Kind==DecisionKind.Returned?"Повернення":d.Kind==DecisionKind.Published?"Публікація":"Надсилання")</strong><p>@d.Comment</p><small>@d.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</small></div>}</div></aside></div>
