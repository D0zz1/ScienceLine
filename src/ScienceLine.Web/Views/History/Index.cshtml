@model HistoryView
@{ViewData["Title"]="Історія версій";var back=User.IsInRole("Editor")?$"/editor/{Model.Article.Id}":$"/author/{Model.Article.Id}";}
<div class="page-heading"><a class="back-link" href="@back">← До матеріалу</a><div class="eyebrow mt-4">ЗМІНИ ЗБЕРІГАЮТЬСЯ</div><h1>Історія версій</h1><p>@Model.Article.Title</p></div>
<form method="get" action="/history/@Model.Article.Id" class="search-panel row g-3"><div class="col-md-5"><label for="from" class="form-label">Початкова версія</label><select name="from" id="from" class="form-select">@foreach(var r in Model.Article.Revisions.OrderBy(x=>x.Number)){<option value="@r.Number" selected="@(r.Number==Model.Before.Number)">Версія @r.Number · @r.CreatedAtUtc.ToString("dd.MM HH:mm") UTC</option>}</select></div><div class="col-md-5"><label for="to" class="form-label">Версія для порівняння</label><select name="to" id="to" class="form-select">@foreach(var r in Model.Article.Revisions.OrderBy(x=>x.Number)){<option value="@r.Number" selected="@(r.Number==Model.After.Number)">Версія @r.Number · @r.CreatedAtUtc.ToString("dd.MM HH:mm") UTC</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-dark w-100">Порівняти</button></div></form>
<div class="row g-4 mb-4"><section class="col-md-6"><div class="form-paper"><div class="eyebrow">НАЗВА У ВЕРСІЇ @Model.Before.Number</div><h2>@Model.Before.Title</h2><p>@Model.Before.Summary</p></div></section><section class="col-md-6"><div class="form-paper"><div class="eyebrow">НАЗВА У ВЕРСІЇ @Model.After.Number</div><h2>@Model.After.Title</h2><p>@Model.After.Summary</p></div></section></div>
<div class="form-paper"><div class="section-top"><h2>Порівняння основного тексту</h2><span class="small">− вилучено · + додано</span></div><div class="diff-lines">@foreach(var line in Model.Lines){<div class="diff-line diff-@line.Kind"><span aria-hidden="true">@(line.Kind=="removed"?"−":line.Kind=="added"?"+":" ")</span><p>@line.Text</p></div>}</div></div>
