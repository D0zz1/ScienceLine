@model ArticleForm
@{ViewData["Title"]=Model.Id==0?"Новий матеріал":"Редагування матеріалу";List<Category> categories=ViewBag.Categories;List<Tag> tags=ViewBag.Tags;var action=Model.Id==0?"/author/create":$"/author/{Model.Id}/edit";}
<div class="page-heading"><a class="back-link" href="/author">← Мої матеріали</a><div class="eyebrow mt-4">АВТОРСЬКА МАЙСТЕРНЯ</div><h1>@ViewData["Title"]</h1><p>Поясніть головне, додайте перевірюване джерело та збережіть чернетку.</p></div>
<form method="post" action="@action" class="editor-form" novalidate>@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="Version" type="hidden"/><input asp-for="ClientRequestId" type="hidden"/><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="row g-4"><div class="col-lg-8"><div class="form-paper"><div class="mb-4"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control form-control-lg" maxlength="160" placeholder="Про що ваш матеріал?"/><span asp-validation-for="Title" class="text-danger"></span></div><div class="mb-4"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" class="form-control" rows="3" maxlength="500" placeholder="Головна ідея, яка зацікавить читача"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div><div class="mb-4"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" class="form-control body-editor" rows="15" maxlength="20000" placeholder="Почніть із запитання або факту. Поясніть контекст і межі висновків."></textarea><div class="form-text">Звичайний текст. Абзаци розділяйте новим рядком; HTML відображається як текст.</div><span asp-validation-for="Body" class="text-danger"></span></div><div><label asp-for="SourceUrl" class="form-label"></label><input asp-for="SourceUrl" class="form-control" type="url" maxlength="1000" placeholder="https://…"/><span asp-validation-for="SourceUrl" class="text-danger"></span></div></div></div>
<aside class="col-lg-4"><div class="form-paper"><h2>Оформлення</h2><div class="mb-4"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" class="form-select"><option value="0">Оберіть рубрику</option>@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</select><span asp-validation-for="CategoryId" class="text-danger"></span></div><fieldset class="mb-4"><legend class="form-label">Теги</legend>@foreach(var t in tags){<label class="tag-option"><input type="checkbox" name="TagIds" value="@t.Id" checked="@(Model.TagIds.Contains(t.Id))"/> @t.Name</label>}</fieldset><div class="mb-3"><label asp-for="CoverKey" class="form-label"></label><select asp-for="CoverKey" class="form-select"><option value="orbit">Орбіти та космос</option><option value="earth">Планета</option><option value="lab">Дослідження</option><option value="digital">Технології</option></select></div><div class="mb-4"><label asp-for="ImageAlt" class="form-label"></label><textarea asp-for="ImageAlt" class="form-control" maxlength="250" rows="3"></textarea><span asp-validation-for="ImageAlt" class="text-danger"></span></div><div class="small text-muted mb-3">Збереження створює приватну версію. Надсилання редактору виконується окремо після перегляду.</div><button class="btn btn-dark btn-lg w-100" type="submit">Зберегти чернетку</button></div></aside></div></form>
