@model Article
@{ViewData["Title"]="Мій матеріал";}
<div class="workspace-heading"><a class="back-link" href="/author">← Мої матеріали</a><div class="article-meta mt-4"><span>@Model.Category.Name</span><span class="status-badge status-@Model.Status">@Model.StatusLabel</span><span>Текстова версія @Model.RevisionNumber</span></div><h1>@Model.Title</h1><div class="d-flex gap-3 flex-wrap my-4">@if(EditorialWorkflow.CanEdit(Model.Status)){<a class="btn btn-outline-dark" href="/author/@Model.Id/edit">Редагувати</a><form method="post" action="/author/@Model.Id/submit">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@Model.Version"/><button class="btn btn-dark" type="submit">Надіслати на перевірку</button></form>}<a class="btn btn-outline-dark" href="/history/@Model.Id">Історія версій</a>@if(Model.Status==ArticleStatus.Published){<a href="/articles/@Model.Id" class="btn btn-dark">Відкрити публікацію ↗</a>}</div></div>
@if(Model.Status==ArticleStatus.ChangesRequested){var last=Model.Decisions.OrderByDescending(x=>x.CreatedAtUtc).FirstOrDefault(x=>x.Kind==DecisionKind.Returned);<div class="alert alert-warning"><strong>Зауваження редактора</strong><p class="mb-0">@last?.Comment</p></div>}
@if(Model.Status==ArticleStatus.UnderReview){<div class="alert alert-info">Матеріал очікує рішення редактора. До завершення перевірки зміни тексту недоступні.</div>}
<div class="row g-4"><div class="col-lg-8"><div class="form-paper"><p class="article-lead">@Model.Summary</p><div class="article-body">@foreach(var line in Model.Body.Replace("\r","").Split('\n').Where(s=>s.Trim().Length>0)){<p>@line</p>}</div><a href="@Model.SourceUrl" rel="noopener noreferrer" target="_blank">Джерело фактів ↗</a></div></div><aside class="col-lg-4"><div class="form-paper"><h2>Редакційна історія</h2>@if(Model.Decisions.Count==0){<p>Рішень ще немає. Збережену чернетку можна надіслати на перевірку.</p>}@foreach(var d in Model.Decisions.OrderByDescending(x=>x.CreatedAtUtc)){<div class="decision-item"><strong>@(d.Kind==DecisionKind.Returned?"Повернено":d.Kind==DecisionKind.Published?"Опубліковано":"Надіслано")</strong><div class="small text-muted">@d.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC · @d.Actor.DisplayName</div><p>@d.Comment</p></div>}</div></aside></div>
