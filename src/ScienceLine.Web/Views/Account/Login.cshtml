@model LoginForm
@{ViewData["Title"]="Вхід";}
<div class="auth-layout"><section class="auth-note"><div class="eyebrow">РАДІ ЗНОВУ БАЧИТИ</div><h1>Добрі тексти<br/>починаються<br/>з цікавості.</h1><p>Увійдіть до своєї робочої області, щоб продовжити матеріал або перевірити редакційне рішення.</p><div class="auth-orbit" aria-hidden="true">✳</div></section><section class="auth-form"><h2>Увійти до порталу</h2><p>Скористайтеся своєю поштою та паролем.</p><form action="/account/login" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="ReturnUrl"/><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control form-control-lg" autocomplete="username" required /></div><div class="mb-4"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" required /></div><button class="btn btn-dark btn-lg w-100" type="submit">Увійти ↗</button></form><p class="mt-4">Хочете писати для порталу? <a href="/account/register">Створити обліковий запис</a></p></section></div>
