@model RegisterForm
@{ViewData["Title"]="Стати автором";}
<div class="auth-layout"><section class="auth-note"><div class="eyebrow">НОВИЙ ГОЛОС У РЕДАКЦІЇ</div><h1>Поясніть те,<br/>що вас<br/>захоплює.</h1><p>Пишіть власні матеріали, зберігайте версії та працюйте із зауваженнями редактора.</p></section><section class="auth-form"><h2>Стати автором</h2><form action="/account/register" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="mb-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" maxlength="100" autocomplete="nickname" required /></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username" required /></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" minlength="12" required/><div class="form-text">Щонайменше 12 символів, великі й малі латинські літери та цифра.</div></div><div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required/></div><button class="btn btn-dark btn-lg w-100">Створити обліковий запис ↗</button></form><p class="mt-3"><a href="/account/login">Уже маю обліковий запис</a></p></section></div>
