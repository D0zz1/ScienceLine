@model RuleError
@{ViewData["Title"]="Повідомлення";}
<div class="empty-state error-state"><div class="eyebrow">ПОВІДОМЛЕННЯ @Model.Status</div><h1>@Model.Message</h1><p>Дані не змінено, якщо дію не було підтверджено. За потреби поверніться до каталогу або своєї робочої області.</p><div class="d-flex justify-content-center gap-3 flex-wrap"><a class="btn btn-dark" href="/articles">До каталогу</a>@if(User.IsInRole("Author")){<a class="btn btn-outline-dark" href="/author">Мої матеріали</a>}@if(User.IsInRole("Editor")){<a class="btn btn-outline-dark" href="/editor">Редакційна черга</a>}</div></div>
