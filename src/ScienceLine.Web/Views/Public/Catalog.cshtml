@model CatalogView
@{ViewData["Title"]="Каталог матеріалів";}
<div class="page-heading"><div class="eyebrow">ВІД ПИТАННЯ ДО ПОЯСНЕННЯ</div><h1>Каталог матеріалів</h1><p>Знайдіть тему, яка зацікавить саме вас.</p></div>
<form method="get" action="/articles" class="search-panel row g-3 align-items-end"><div class="col-md-7"><label for="q" class="form-label">Пошук за назвою та текстом</label><input id="q" name="q" value="@Model.Query" maxlength="200" class="form-control form-control-lg" placeholder="Наприклад, телескоп або енергія" /></div><div class="col-md-3"><label for="category" class="form-label">Рубрика</label><select id="category" name="category" class="form-select form-select-lg"><option value="">Усі рубрики</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>}</select></div><div class="col-md-2"><button class="btn btn-dark btn-lg w-100" type="submit">Знайти</button></div></form>
<div class="results-line"><span>Знайдено матеріалів: <strong>@Model.Total</strong></span><a href="/articles">Скинути фільтри</a></div>
@if(Model.Articles.Count==0){<div class="empty-state"><span aria-hidden="true">⊙</span><h2>За цим запитом матеріалів немає</h2><p>Спробуйте інші слова або оберіть усі рубрики.</p><a href="/articles" class="btn btn-outline-dark">Показати всі матеріали</a></div>}
<div class="row g-4">@foreach(var a in Model.Articles){<div class="col-md-6 col-lg-4"><partial name="_Card" model="a" /></div>}</div>
<nav class="pagination-bar" aria-label="Сторінки каталогу">@if(Model.Page>1){<a class="btn btn-outline-dark" href="/articles?q=@Uri.EscapeDataString(Model.Query)&category=@Model.CategoryId&page=@(Model.Page-1)">← Попередня</a>}@if(Model.Total>Model.Page*9){<a class="btn btn-outline-dark" href="/articles?q=@Uri.EscapeDataString(Model.Query)&category=@Model.CategoryId&page=@(Model.Page+1)">Наступна →</a>}</nav>
