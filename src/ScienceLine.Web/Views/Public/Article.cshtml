@model Article
@{ViewData["Title"]=Model.Title;}
<article class="reading-page"><a class="back-link" href="/articles">← Усі матеріали</a><div class="eyebrow mt-4">@Model.Category.Name · @Model.PublishedAtUtc?.ToString("dd.MM.yyyy")</div><h1>@Model.Title</h1><p class="article-lead">@Model.Summary</p><div class="byline">@Model.Author.DisplayName · Редакційно перевірено</div><figure><img class="reading-cover" src="/images/@(Model.CoverKey).svg" alt="@Model.ImageAlt"/><figcaption>@Model.ImageAlt. Схематична ілюстрація.</figcaption></figure><div class="article-body">@foreach(var line in Model.Body.Replace("\r","").Split('\n').Where(x=>!string.IsNullOrWhiteSpace(x))){<p>@line</p>}</div><div class="source-note"><strong>Походження фактів</strong><p>Перевірте контекст і докладні пояснення у першоджерелі.</p><a href="@Model.SourceUrl" rel="noopener noreferrer" target="_blank">Відкрити джерело ↗</a></div><div class="tag-list">@foreach(var t in Model.ArticleTags){<span>#@t.Tag.Name</span>}</div></article>
